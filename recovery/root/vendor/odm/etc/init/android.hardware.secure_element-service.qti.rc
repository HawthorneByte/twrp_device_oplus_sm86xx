# Started once qseecomd has registered its listeners; this HAL calls
# QSEECom_start_app. se_omapi proxies to it, and that is how the weaver
# transport reaches the eSE.

service vendor.secure_element /odm/bin/hw/android.hardware.secure_element-service.qti
    class hal
    user root
    group nfc root
    disabled
    setenv LD_LIBRARY_PATH /vendor/lib64:/vendor/lib64/hw:/system/lib64:/sbin:/odm/lib64
    seclabel u:r:recovery:s0
